# =====================================================================
# Altera Demos · Variables de entorno (copia este archivo a .env)
#   cp .env.example .env
# El .env NUNCA se sube a git (está en .gitignore) ni se publica en la web.
# Las demos públicas usan audios MP3 pregenerados con estas claves.
# =====================================================================

# --- ElevenLabs (voz IA) --------------------------------------------
# https://elevenlabs.io/app/settings/api-keys  (permiso: Text to Speech)
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# Voz por demo (voice_id de tu biblioteca ElevenLabs).
# _AGENT = el asistente IA · _CLIENT = la voz del cliente en las llamadas simuladas.
# Si se dejan vacías se usan las voces por defecto de cada demo.
ELEVENLABS_VOICE_VIBRA_AGENT=mGlMpcOq63YZLdidTVyo
ELEVENLABS_VOICE_VIBRA_CLIENT=
ELEVENLABS_VOICE_PIZZERIA_ANGELA_AGENT=
ELEVENLABS_VOICE_PIZZERIA_ANGELA_CLIENT=
ELEVENLABS_VOICE_RUAUTOS_AGENT=mGlMpcOq63YZLdidTVyo
ELEVENLABS_VOICE_MOTOS_AGENT=mGlMpcOq63YZLdidTVyo
ELEVENLABS_VOICE_REALESTATE_AGENT=uQw4jpKzMLrZuo0RLPS9
ELEVENLABS_VOICE_SALON224_AGENT=uQw4jpKzMLrZuo0RLPS9
ELEVENLABS_VOICE_SONRISASTAR_AGENT=uQw4jpKzMLrZuo0RLPS9
ELEVENLABS_VOICE_ADELA_FISIO_AGENT=EXAVITQu4vr4xnSDxMaL
# Voz por defecto si una demo no tiene la suya
ELEVENLABS_VOICE_DEFAULT_AGENT=uQw4jpKzMLrZuo0RLPS9
ELEVENLABS_VOICE_DEFAULT_CLIENT=ErXwobaYiN019PkySvjV

# --- RapidAPI · Idealista (radar inmobiliario de Izon / realestate) ---
# https://rapidapi.com/  → app → API key. Solo se usa en local o para
# generar la instantánea realestate/data/idealista-snapshot.json
RAPIDAPI_KEY=
RAPIDAPI_IDEALISTA_HOST=idealista17.p.rapidapi.com

# --- Servidor local de desarrollo ------------------------------------
DEV_PORT=5173
